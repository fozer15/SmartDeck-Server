PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://user:password@host:5432/smartdeck

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Cloudflare R2 (for file uploads)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-bucket.r2.dev
# R2 bucket CORS must allow your client origins to upload directly.
# Example bucket CORS rule:
# [
#   {
#     "AllowedOrigins": ["http://localhost:5173", "https://your-client-domain.com"],
#     "AllowedMethods": ["GET", "HEAD", "PUT"],
#     "AllowedHeaders": ["Content-Type"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3600
#   }
# ]

# Firebase Admin SDK (download from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"

# RevenueCat
RC_API_KEY=your_revenuecat_api_key_here
RC_WEBHOOK_AUTH=your_revenuecat_webhook_auth_here
STRIPE_RC_API_KEY=your_revenuecat_stripe_api_key_here

# Stripe production
STRIPE_SECRET_KEY=your_live_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_live_stripe_webhook_secret_here
STRIPE_PRO_MONTHLY_PRICE_ID=your_live_monthly_price_id_here
STRIPE_PRO_YEARLY_PRICE_ID=your_live_yearly_price_id_here

# Stripe test sandbox
STRIPE_TEST_SECRET_KEY=your_test_stripe_secret_key_here
STRIPE_TEST_WEBHOOK_SECRET=your_test_stripe_webhook_secret_here
STRIPE_TEST_PRO_MONTHLY_PRICE_ID=your_test_monthly_price_id_here
STRIPE_TEST_PRO_YEARLY_PRICE_ID=your_test_yearly_price_id_here
