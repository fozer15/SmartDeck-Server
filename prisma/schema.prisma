generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id 
  email         String          @unique 
  name          String?
  avatarUrl     String?
  
  // Gamification & Habit Tracking
  globalStreak  Int             @default(0)
  lastActive    DateTime?       
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  files         UploadedFile[]
  quizzes       GeneratedQuiz[]
  sessions      StudySession[]  // Links to active study states
}

model UploadedFile {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String
  r2Key        String
  mimeType     String
  size         Int
  createdAt    DateTime        @default(now())
  quizzes      GeneratedQuiz[] 
}

model GeneratedQuiz {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Deck Metadata & Marketplace Settings
  title       String          @default("Untitled Deck")
  subject     Subject?
  questionCount Int?
  questionTier  QuizTierPreference?
  questionFormat QuizFormatPreference?
  isPublic    Boolean         @default(false) 
  
  rigorIndex  Float
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  files       UploadedFile[] 
  questions   QuizQuestion[]
  sessions    StudySession[]
}

enum QuestionTier {
  recall
  application
  analysis
}

// Allows for a "Mixed Deck" experience
enum QuestionFormat {
  multiple_choice
  flashcard
  short_answer
}

enum QuizTierPreference {
  recall
  application
  analysis
  mixed
}

enum QuizFormatPreference {
  multiple_choice
  flashcard
  short_answer
  mixed
}

model QuizQuestion {
  id            String          @id @default(cuid())
  quizId        String
  quiz          GeneratedQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  format        QuestionFormat  @default(multiple_choice)
  tier          QuestionTier
  
  // Dynamic Content Fields
  question      String          // Acts as the prompt or "Front" of a flashcard
  options       String[]        // Leave empty if format is 'flashcard'
  correctAnswer String          // Acts as the "Back" of a flashcard
  explanation   String?         // Optional for simple vocabulary cards
  
  topic         String?         
  orderIndex    Int             // The immutable original order from the PDF
  
  // Spaced Repetition / Mastery Stats
  timesAnswered Int             @default(0)
  timesCorrect  Int             @default(0)
  streak        Int             @default(0)
  lastReviewed  DateTime?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@index([quizId])
}

// The Active Session Engine (Handles Resuming & Shuffling)
model StudySession {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId        String
  quiz          GeneratedQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  // State Management
  questionQueue String[]        // Array of QuizQuestion IDs (can be safely shuffled)
  currentIndex  Int             @default(0)
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([userId, quizId])
  @@index([userId])
}

