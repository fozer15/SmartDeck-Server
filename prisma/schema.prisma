generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id 
  email         String          @unique 
  name          String?
  avatarUrl     String?
  school        String?
  degree        String?
  preferredLanguage AppLanguage @default(en)
  
  // Gamification & Habit Tracking
  globalStreak  Int             @default(0)
  lastActive    DateTime?       
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  files         UploadedFile[]
  quizzes       GeneratedQuiz[]
  sessions      StudySession[]  // Links to active study states
  likes         DeckLike[]
  saves         DeckSave[]
  tutorConversations TutorConversation[] 
  following     UserFollow[]    @relation("UserFollowing")
  followers     UserFollow[]    @relation("UserFollowers")
}

model UploadedFile {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String
  r2Key        String
  mimeType     String
  size         Int
  createdAt    DateTime        @default(now())
  quizzes      GeneratedQuiz[] 
}

model GeneratedQuiz {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Deck Metadata & Marketplace Settings
  title       String          @default("Untitled Deck")
  subject     Subject
  language    AppLanguage     @default(en)
  questionCount Int?
  questionTier  QuizTierPreference?
  questionFormat QuizFormatPreference?
  isPublic    Boolean         @default(false) 
  
  rigorIndex  Float
  gradingContext String?
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  files       UploadedFile[] 
  questions   QuizQuestion[]
  sessions    StudySession[]
  likes       DeckLike[]
  saves       DeckSave[]
  tutorConversations TutorConversation[] 
}

model TutorConversation {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      GeneratedQuiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  // Track system contexts or metadata if the AI needs an overarching summary 
  summary   String?        // Optional: LLM-generated headline of what was discussed
  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TutorMessage[]

  // Ensures a clean 1:1 mapping if a user has exactly one running chat session per deck.
  // If you want history lines (multiple independent chats per deck), remove @@unique and use @@index instead.
  @@unique([userId, quizId])
  @@index([userId])
  @@index([quizId])
}

enum TutorRole {
  user
  assistant
  system
}

model TutorMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  role           TutorRole         @default(user)
  text           String            @db.Text // Guarantees support for lengthy explanations and markdown tables
  
  // Optional: tracking metadata for contextual AI actions
  isFlagged      Boolean           @default(false)
  
  createdAt      DateTime          @default(now())

  // Fast historical lookups inside the chat log window
  @@index([conversationId, createdAt])
}

enum QuestionTier {
  recall
  application
  analysis
}

enum AppLanguage {
  en
  zh
  hi
  es
  fr
  tr
  pt
}

// Allows for a "Mixed Deck" experience
enum QuestionFormat {
  multiple_choice
  flashcard
  short_answer
}

enum QuizTierPreference {
  recall
  application
  analysis
  mixed
}

enum QuizFormatPreference {
  multiple_choice
  flashcard
  short_answer
  mixed
}

model QuizQuestion {
  id            String          @id @default(cuid())
  quizId        String
  quiz          GeneratedQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  format        QuestionFormat  @default(multiple_choice)
  tier          QuestionTier
  
  // Dynamic Content Fields
  question      String          // Acts as the prompt or "Front" of a flashcard
  options       String[]        // Leave empty if format is 'flashcard'
  correctAnswer String          // Acts as the "Back" of a flashcard
  explanation   String
  gradingContext String?
  
  topic         String?         
  orderIndex    Int             // The immutable original order from the PDF

  // Session-scoped mastery stats are tracked in StudySessionQuestionProgress
  sessionProgresses StudySessionQuestionProgress[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@index([quizId])
}

// The Active Session Engine (Handles Resuming & Shuffling)
model StudySession {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId        String
  quiz          GeneratedQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  // State Management
  questionQueue String[]        // Array of QuizQuestion IDs (can be safely shuffled)
  currentIndex  Int             @default(0)

  questionProgress StudySessionQuestionProgress[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([userId, quizId])
  @@index([userId])
}

model StudySessionQuestionProgress {
  id            String        @id @default(cuid())
  sessionId     String
  session       StudySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String
  question      QuizQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  timesAnswered Int           @default(0)
  timesCorrect  Int           @default(0)
  streak        Int           @default(0)
  lastReviewed  DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
}

model DeckLike {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId    String
  deck      GeneratedQuiz @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, deckId])
  @@index([userId])
  @@index([deckId])
}

model DeckSave {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId    String
  deck      GeneratedQuiz   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, deckId])
  @@index([userId])
  @@index([deckId])
}

model UserFollow {
  id           String   @id @default(cuid())
  followerId   String
  followingId  String
  createdAt    DateTime @default(now())

  follower     User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following    User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

